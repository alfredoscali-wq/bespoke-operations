# Copy to /etc/bespoke/network-agent/agent.env (mode 0600, owner root:bespoke-agent).
# Do not store MikroTik device passwords here. Those arrive from Cloud on job claim.

NETWORK_CLOUD_URL=https://<origin-operations>
NETWORK_AGENT_TOKEN=bna_<redacted>
NETWORK_AGENT_POLL_MS=5000
NETWORK_ROUTEROS_TLS=1
NETWORK_ROUTEROS_CA_FILE=/etc/bespoke/ca/bespoke-monitoring-ca.pem
